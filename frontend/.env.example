# ============================================
# NexusAI Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env — it is gitignored.

# Backend API base URL (Vite dev server proxies /api to this)
VITE_API_URL=http://localhost:5000

# Set to true to enable Google/GitHub OAuth buttons on the login page
VITE_ENABLE_OAUTH=false

# Supabase Auth (optional but recommended) — anon key only, safe to expose
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# When Supabase is configured, add these to Supabase Auth redirect URLs:
#   http://localhost:5173/supabase/callback
#   http://localhost:5173/reset-password
