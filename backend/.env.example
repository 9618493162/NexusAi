# ============================================
# NexusAI Backend Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env — it is gitignored.

# --- Database ---
# Supabase Postgres via the session pooler (IPv4 — direct db.<ref>.supabase.co
# is IPv6-only and flaky on some networks):
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis (optional; Docker service name 'redis' for docker-compose) ---
REDIS_URL=redis://localhost:6379

# --- JWT Secrets (generate with: openssl rand -base64 32) ---
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# --- Chat providers ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
KIMI_API_KEY=your_moonshot_api_key
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# --- Media providers ---
# Image generation
NVIDIA_IMAGE_API_KEY=your_nvidia_image_api_key_here
APIFRAME_API_KEY=your_apiframe_api_key_here
FAL_API_KEY=your_fal_api_key_here
PIXAZO_API_KEY=your_pixazo_api_key_here
# Video generation (Gemini media key powers Veo; also used for Gemini image gen)
GEMINI_MEDIA_API_KEY=your_gemini_media_api_key_here
VADOO_API_KEY=your_vadoo_api_key_here
JSON2VIDEO_API_KEY=your_json2video_api_key_here

# --- Voice ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Supabase Auth (optional but recommended) ---
# When set, login/register/password-recovery go through Supabase Auth.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # server-side only, never exposed

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173

# --- File Processor Service ---
FILE_PROCESSOR_URL=http://localhost:8000
FILE_PROCESSOR_TIMEOUT=300000
ENABLE_FILE_PROCESSOR=true

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
SESSION_SECRET=your_session_secret_here

# --- Email (Optional - for password reset when Supabase Auth is not used) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@nexusai.com
RESEND_API_KEY=your_resend_api_key_here
TINYFISH_API_KEY=your_tinyfish_api_key_here

# --- Node Environment ---
NODE_ENV=development
PORT=5000

# AI Power Grid (aipowergrid.io) — free OpenAI-compatible chat streaming
GRID_API_KEY=
