# ============================================
# NexusAI Backend Environment Variables
# ============================================

# --- Database (Docker service name 'postgres') ---
# DO NOT use localhost here - use the service name
DATABASE_URL=postgresql://nexusai:nexusai_secret@postgres:5432/nexusai

# --- Redis (Docker service name 'redis') ---
# DO NOT use localhost here - use the service name
REDIS_URL=redis://redis:6379

# --- JWT Secrets (generate with: openssl rand -base64 32) ---
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# --- Groq API (get free key at https://console.groq.com) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:3000

# --- File Processor Service ---
FILE_PROCESSOR_URL=http://file-processor:8000
FILE_PROCESSOR_TIMEOUT=300000
ENABLE_FILE_PROCESSOR=true

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
SESSION_SECRET=your_session_secret_here

# --- Email (Optional - for password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@nexusai.com

# --- Node Environment ---
NODE_ENV=production
PORT=5000
